{
  // Keep in sync with Renovate!
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "html": {
    "enabled": true,
    "fileMatch": [
      "\\.(go)?html?$"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        // Postgres requires a manual upgrade
        // and are not exposed publicly anyway.
        "postgres"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "platformAutomerge": true
}
